+/// entry — same wire shape as getdata (protocol.h CInv).
+pub fn build_inv(inv: &[(u32, Hash)]) -> Vec<u8> {
+    let mut w = Vec::new();
+    push_compact_size(&mut w, inv.len() as u64);
+    for (t, h) in inv {
+        w.extend_from_slice(&t.to_le_bytes());
+        w.extend_from_slice(h);
