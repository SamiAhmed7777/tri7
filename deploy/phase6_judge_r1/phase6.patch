+            let mut ln = [0u8; 1];
+            r.read_exact(&mut ln)
+                .map_err(|e| format!("socks reply: {}", e))?;
+            drain(r, ln[0] as usize + 2)
+        }
+        0x04 => drain(r, 16 + 2),
+        other => Err(format!("socks reply: unknown ATYP {:#x}", other)),
+    }
