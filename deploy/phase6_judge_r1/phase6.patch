+fn socks5_connect_request(host: &str, port: u16) -> Vec<u8> {
+    let mut w = Vec::new();
+    w.push(0x05); // VER
+    w.push(0x01); // CMD CONNECT
+    w.push(0x00); // RSV
+    let octets: Option<Vec<u8>> = host
+        .split('.')
+        .map(|o| o.parse::<u8>())
+        .collect::<Result<Vec<u8>, std::num::ParseIntError>>()
