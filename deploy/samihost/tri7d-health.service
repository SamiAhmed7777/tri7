[Unit]
Description=tri7d healthcheck (Samihost): stale-state + network-quiet gate, restarts tri7d on failure
# GATES (follow_tip --status, exit codes):
#   exit 0  healthy
#   exit 3  state unreadable OR stale write (age > 600s: the loop rewrites
#           tipstate.json every 30s while alive) OR DEGRADED — no peer
#           traffic for > 600s AND no tip advance for > 1800s. Any nonzero
#           exit restarts tri7d.service (try-restart).
[Service]
Type=oneshot
ExecStart=/bin/sh -c '/opt/tri7/bin/follow_tip --status --state-dir /var/lib/tri7 --max-write-age 600 --advance-quiet-secs 7200 > /dev/null 2>&1 || { echo "tri7d healthcheck FAILED (rc=$?) — restarting tri7d"; systemctl try-restart tri7d.service; exit 1; }'
# --advance-quiet-secs 7200 (vs default 1800): this is a FOLLOWER behind DNS2.
# Poll ticks (30s) keep peer-traffic green; the TIP only moves when DNS2's
# staker mints (~30-90min cadence observed). A 30min advance gate would flap
# the unit on DNS2's normal mint cadence. 2h still catches a truly frozen
# follower.
