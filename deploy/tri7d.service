[Unit]
Description=tri7 daemon (tip follower + native RPC surface, read-only P2P client)
Documentation=file:/root/tri7/HANDOFF.md
After=network-online.target trianglesd.service
Wants=network-online.target

[Service]
Type=simple
User=tri7
Group=tri7
# RPC surface (phase 5b, daemon-replacement build):
#   - native JSON-RPC listener (--rpc-port; loopback ONLY, 1MB request cap).
#     NEVER binds 19112 while the legacy daemon owns it.
#     PORT NOTE: 19113 on DNS2 is held by an autossh tunnel
#     (ssh -L 19113:127.0.0.1:19112 -> sami-pc, live consumer attached),
#     so the deployed listener runs on 19114 until cutover. At cutover:
#     stop the autossh tunnel, set --rpc-port 19113 here, restart.
#     The LEGACY CLIENT port (19112) is the binary default and stays untouched.
#   - native data sources: tipstate window, blockindex over
#     /var/lib/tri7/blk0001.dat (HARDLINK to the daemon's file -- same inode,
#     zero disk cost, sees appends), replay snapshots balances.json +
#     wallet_utxos.json (phase-1e replay pattern, NOT a live UTXO set).
#   - the legacy-RPC proxy is a TRANSITIONAL fallback for methods the native
#     path cannot serve yet; every response carries "source":
#     "tri7"|"legacy-proxy" so cutover progress is measurable.
ExecStart=/opt/tri7/bin/follow_tip --daemon 127.0.0.1:24113 --conf /etc/tri7/triangles.conf --state-dir /var/lib/tri7 --forever --rpc-port 19114 --rpc-bind 127.0.0.1 --blocks-file /var/lib/tri7/blk0001.dat --balances /var/lib/tri7/balances.json --wallet-utxos /var/lib/tri7/wallet_utxos.json --index-dir /var/lib/tri7/index
# Healthcheck (manual/cron):
#   /opt/tri7/bin/follow_tip --status --state-dir /var/lib/tri7
#     JSON: tip height, last_advance_utc (real tip advances only),
#     state-write age, daemon_tip, at_daemon_tip.
#     exit 0 healthy; 3 unreadable state OR stale (write age > --max-write-age,
#     default 600s -- the loop rewrites tipstate.json every 30s while alive).
Restart=on-failure
# Note: any non-zero exit (2 usage / 3 validation / 4 protocol / 5 seed) and
# signal death trigger this restart; `systemctl stop` stays stopped.
RestartSec=30
# Footprint bound: window ~13MB + block index ~53MB + tx index ~72MB + height
# maps ~26MB + snapshots ~10MB ~= 175MB steady; ~200MB transient during the
# first index build (subsequent restarts load the on-disk caches in ~1-2s).
# 512M ~= 2.5x steady headroom; legacy trianglesd is ~1.5GB by comparison.
MemoryMax=512M
# Hardening: outbound loopback P2P + RPC client, inbound LOOPBACK-ONLY RPC
# listener; needs write access to its state dir (tipstate + index caches);
# conf copy (not /root/.triangles) for RPC creds; blocks file via hardlink.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/tri7
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
