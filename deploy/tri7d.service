[Unit]
Description=tri7 daemon (DNS2 primary: native RPC + P2P listener + relay)
Documentation=file:/root/tri7/HANDOFF.md
After=network-online.target tor.service trianglesd.service
Wants=network-online.target

[Service]
Type=simple
User=tri7
Group=tri7
# TOPOLOGY (single source of truth — keep HANDOFF.md in sync with this):
#   tri7d IS the DNS2 primary node. Legacy trianglesd remains active for
#   its existing consumers and owns public 24113. Ports:
#     19112  native JSON-RPC (loopback ONLY; 1MB request cap; --no-proxy)
#     24113  legacy trianglesd public P2P; never start tri7d here
#     24114  tri7d loopback P2P listener; tor HS gxvrhv3qitnc6kobrhsrse46bmcfitnybapor3or3oczzuxn6hfzxyid.onion
#            :24113 -> 127.0.0.1:24114. All three nodes order tri7d after tor.
#     19113  autossh tunnel to sami-pc's RPC (triangles-api consumer) —
#            UNRELATED to tri7d, never bind or re-route it
#   Authoritative onion/seed table: docs/network-seeds.md. Every fleet node
#   seeds both peers; live acceptance requires six directed protocol-70206
#   /tri7:7.0.0/ sessions, not just a SOCKS TCP reply.
#   Inbound peers get handshake + getdata/getheaders serving and may push
#   validated blocks, which are relayed to all peers (inv -> getdata).
#   Data sources: tipstate window, blockindex over /var/lib/tri7/blk0001.dat
#   (hardlink to the daemon's file), replay snapshots (NOT a live UTXO set),
#   plus an in-RAM recent-blocks cache for heights above the file's tip.
#   Every RPC response carries "source": "tri7".
ExecStart=/opt/tri7/bin/follow_tip \
  --daemon 100.85.236.10:24113,100.85.236.10:24112 \
  --daemon 100.81.59.99:24112,100.81.59.99:24113 \
  --onion brudzmft5zvvrvlzfeywy2n7gh4bu7egsbjab4ois6xwxgnqjitxywid.onion:24113 \
  --socks 127.0.0.1:9050 \
  --listen-port 24114 --listen-bind 127.0.0.1 \
  --conf /etc/tri7/triangles.conf --state-dir /var/lib/tri7 --forever \
  --rpc-port 19112 --rpc-bind 127.0.0.1 --no-proxy \
  --blocks-file /var/lib/tri7/blk0001.dat \
  --balances /var/lib/tri7/balances.json \
  --wallet-utxos /var/lib/tri7/wallet_utxos.json \
  --index-dir /var/lib/tri7/index
# Healthcheck (tri7d-health.timer, every 5 min):
#   /opt/tri7/bin/follow_tip --status --state-dir /var/lib/tri7
#     exit 0 healthy; 3 when state unreadable OR stale (write age >
#     --max-write-age, default 600s) OR DEGRADED: no peer traffic for >
#     --peer-quiet-secs (600s) AND no tip advance for >
#     --advance-quiet-secs (1800s). A network primary that can neither reach
#     peers nor follow the chain is NOT healthy; pass --static to skip the
#     network-quiet gate (explicit static/air-gapped mode only).
Restart=on-failure
# Note: any non-zero exit (2 usage / 3 validation / 4 protocol / 5 seed) and
# signal death trigger this restart; `systemctl stop` stays stopped.
RestartSec=30
# Footprint bound, from live measurements on the 2.22M-height chain
# (2026-11-25, workqueue item 47; docs/memory-headroom-2026-11-25.md):
# - a boot needs 0.45-0.5 GiB of non-reclaimable memory (anon + kernel), plus
#   page cache on top that the kernel can reclaim;
# - the same binary where swap was allowed peaked at 907 MiB RAM plus
#   456 MiB swap in one boot; RAM+swap upper bound 1307 MiB over 12 boots
#   in 14 days (the boot-time transient, workqueue item 48);
# - a 512M cap on that host OOM-killed the staker 21 times in 7 hours.
# 2G = 1.57x the largest observed bound. Size per host: never below 1.25x
# the largest per-boot footprint observed for this binary, and keep at least
# ceiling + 1 GiB available to the host.
# The earlier figures in this comment (12.7 MB peak RSS, ~180 MB steady)
# were measured on a short chain and are obsolete.
MemoryMax=2G
# No swap for the staker: a spike must show up in memory.peak / memory.events
# (and be killed cleanly at MemoryMax) rather than hide in swap.
MemorySwapMax=0
# Hardening: outbound P2P rotation + tor SOCKS + inbound P2P listener +
# loopback-only RPC; write access limited to its state dir; conf copy (not
# /root/.triangles) for RPC creds; blocks file via hardlink.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/tri7
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
