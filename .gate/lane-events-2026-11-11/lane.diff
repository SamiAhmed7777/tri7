+    s2.set_read_timeout(Some(Duration::from_secs(5))).unwrap();
+    let resp2 = read_until_sse(&mut s2, "no live node engine", Duration::from_secs(5));
+    assert!(resp2.starts_with("HTTP/1.1 404"), "stub-ops /events must 404, got: {resp2}");
+}
