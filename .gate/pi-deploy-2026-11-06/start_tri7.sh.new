#!/usr/bin/env bash
# Activate tri7 on the aarch64 box as a PURE FULL NODE: the attached wallet
# is a freshly created ZERO-KEY container (no coins possible - the funded
# keys live on sami-pc per the operator directive of 2026-11-07). The ops
# RPC gate (follow_tip.rs OpsAdapter::ready) requires a wallet live view, so
# the node runs with the empty container rather than no wallet file. The
# former funded wallet copy is archived on DNS2:
# /root/tri7-recovery/pi-wallet-archive/ (sha256 2de64382...).
# TOR ONLY: .onion peers via the local SOCKS proxy; P2P listener bound to
# loopback so no clearnet address is ever exposed or dialled.
set -euo pipefail

BIN=/root/tri7/target/release/follow_tip
STATE=/var/lib/tri7
PIDFILE=$STATE/tri7d.pid
LOG=$STATE/tri7d.log
# fresh zero-key wallet container (created 2026-11-07; NEVER holds funds)
WALLET_DIR=/root/tri7-wallet
EMPTY_WALLET=$WALLET_DIR/wallet-empty.dat

# Tor-only peers. DNS2's LIVE onion (port 24113 -> its P2P listener).
ONIONS="gxvrhv3qitnc6kobrhsrse46bmcfitnybapor3or3oczzuxn6hfzxyid.onion:24113"

[[ -x $BIN ]] || { echo "FAIL: $BIN missing"; exit 1; }

# Tor must actually be running - refuse to start without it rather than
# silently falling back to clearnet.
if ! (exec 3<>/dev/tcp/127.0.0.1/9050) 2>/dev/null; then
  echo "FAIL: Tor SOCKS is not listening on 127.0.0.1:9050 - start tor@default first"
  exit 2
fi

mkdir -p "$STATE" "$WALLET_DIR"

# The zero-key wallet container must exist and be exactly that: tri7 schema,
# zero rows. Create it if missing; refuse to start on any mismatch (the ops
# RPC gate requires a wallet live view, and a funded container must never be
# attached here - the funded wallet lives on sami-pc).
if [[ ! -f $EMPTY_WALLET ]]; then
  python3 - "$EMPTY_WALLET" <<'PYEOF'
import sqlite3, sys
con = sqlite3.connect(sys.argv[1])
con.execute("PRAGMA application_id = 1414687095")
con.execute("PRAGMA user_version = 1")
con.execute("CREATE TABLE main (key BLOB, value BLOB)")
con.commit()
con.close()
PYEOF
  chmod 600 "$EMPTY_WALLET"
  echo "created zero-key wallet: $EMPTY_WALLET"
fi
WALLET_CHECK=$(python3 - "$EMPTY_WALLET" <<'PYEOF'
import sqlite3, sys
try:
    con = sqlite3.connect(sys.argv[1])
    app = con.execute("PRAGMA application_id").fetchone()[0]
    uv = con.execute("PRAGMA user_version").fetchone()[0]
    n = con.execute("SELECT COUNT(*) FROM main").fetchone()[0]
    tables = [r[0] for r in con.execute("SELECT name FROM sqlite_master WHERE type='table'")]
    print(f"{app}:{uv}:{n}:{sorted(tables)}")
except Exception as e:
    print(f"ERR:{e}")
PYEOF
)
if [[ $WALLET_CHECK != "1414687095:1:0:['main']" ]]; then
  echo "FAIL: $EMPTY_WALLET is not the expected zero-key container (got $WALLET_CHECK); refusing to start"
  exit 3
fi


if [[ -f $PIDFILE ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
  echo "already running pid $(cat "$PIDFILE")"
  exit 0
fi

echo "commit: $(cat /root/tri7/BUILD_COMMIT 2>/dev/null || echo unknown)"
echo "mode: full node, zero-key wallet (no coins)"
nohup "$BIN" \
  --socks 127.0.0.1:9050 \
  --daemon "$ONIONS" \
  --listen-port 24112 --listen-bind 127.0.0.1 \
  --state-dir "$STATE" \
  --blocks-file /root/.triangles/blk0001.dat \
  --index-dir "$STATE/index" \
  --wallet "$EMPTY_WALLET" \
  --rpc-port 19112 --rpc-bind 127.0.0.1 --no-proxy \
  --backfill 0 --forever \
  > "$LOG" 2>&1 &
echo $! > "$PIDFILE"
echo "started pid $(cat "$PIDFILE") (Tor-only, zero-key wallet)"

for i in $(seq 1 120); do
  if (exec 3<>/dev/tcp/127.0.0.1/19112) 2>/dev/null; then
    echo "RPC up after $((i*2))s"
    exit 0
  fi
  sleep 2
done
echo "RPC did not open within 240s; log tail:"
tail -20 "$LOG"
exit 1
