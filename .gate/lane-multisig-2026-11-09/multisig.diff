+/// createmultisig (createMultisig lane item): the create-only sibling of
+/// addmultisigaddress — canonical vector end-to-end, legacy error surfaces
+/// byte-for-byte, the wallet file never touched, and NATIVE_METHODS routing
+/// proven (a handler without membership would answer -32601 pre-dispatch).
+#[test]
+fn createmultisig_creates_without_touching_the_wallet_file() {
+    // routing assertions: gated into NATIVE_METHODS, and deliberately in
+    // NEITHER ops list (pure computation — no ops-engine state)
+    assert!(
+        NATIVE_METHODS.contains(&"createmultisig"),
+        "createmultisig missing from NATIVE_METHODS"
+    );
+    assert!(
+        !OPS_METHODS.contains(&"createmultisig"),
+        "createmultisig must not be in OPS_METHODS"
+    );
+    assert!(
+        !PROXY_FALLBACK_METHODS.contains(&"createmultisig"),
+        "createmultisig must not be in PROXY_FALLBACK_METHODS"
+    );
+
+    let t = T;
+    let w = StubWallet::default();
+    let b = StubBlocks { ready: true, chain_hash: None };
+    let d = Deps { tip: &t, wallet: &w, blocks: &b, proxy: None, ops: None };
+
+    // canonical compressed pubkeys for privkeys 1..=3 — the published
+    // p2sh-multisig reference vector (proven live in multisig.rs against
+    // CJU8gKtn4aNBBovbywqPqZo6mjA1B1pLD1)
+    let pk = |n: u64| -> Vec<u8> {
+        let mut secret = [0u8; 32];
+        secret[31] = n as u8;
+        let sk = secp256k1::SecretKey::from_slice(&secret).unwrap();
+        let secp = secp256k1::Secp256k1::signing_only();
+        secp256k1::PublicKey::from_secret_key(&secp, &sk)
+            .serialize()
+            .to_vec()
+    };
+    assert_eq!(
+        hex_encode(&pk(1)),
+        "0279be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798"
+    );
+    let keys = [hex_encode(&pk(1)), hex_encode(&pk(2)), hex_encode(&pk(3))];
+
+    // a wallet file on disk — createmultisig must leave it untouched
+    let dir = std::env::temp_dir().join(format!("tri7rpc_cms_{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    let path = dir.join("wallet.dat");
+    crate::wallet::create_wallet_file(&path).unwrap();
+    // NOTE: no TRI7_WALLET_PATH mutation here — the createmultisig handler is
+    // pure (never reads the env); the untouched-checks below read `path`
+    // directly. Keeps this test free of process-global state.
+
+    // canonical vector: 2-of-3 → the live-proven P2SH address + exact script
+    let v = call(&d, "createmultisig", json!([2, keys]));
+    assert_eq!(v["error"], Value::Null, "unexpected error: {v}");
+    assert_eq!(v["result"]["address"], "CJU8gKtn4aNBBovbywqPqZo6mjA1B1pLD1");
+    assert_eq!(
+        v["result"]["redeemScript"],
+        "52210279be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798\
+         2102c6047f9441ed7d6d3045406e95c07cd85c778e4b8cef3ca7abac09b95c709ee5\
+         2102f9308a019258c31049344f85f89d5229b531c845836f99b08601f113bce036f9\
+         53ae"
+            .replace(char::is_whitespace, "")
+    );
+
+    // create-only: the wallet file carries NO redeem script and NO label row
+    {
+        let wf = crate::wallet::read_wallet(&path).unwrap();
+        assert!(
+            wf.scripts.is_empty(),
+            "createmultisig must not store scripts: {:?}",
+            wf.scripts
+        );
+        assert!(
+            wf.names.is_empty(),
+            "createmultisig must not write labels: {:?}",
+            wf.names
+        );
+    }
+
+    // duplicates are ACCEPTED — legacy SetMultisig (script.cpp) has no
+    // duplicate check and neither do we
+    let v = call(
+        &d,
+        "createmultisig",
+        json!([1, [keys[0].clone(), keys[0].clone()]]),
+    );
+    assert_eq!(v["error"], Value::Null, "duplicate keys must be accepted: {v}");
+    let dup = crate::multisig::redeem_script(1, &[pk(1), pk(1)]).unwrap();
+    assert_eq!(v["result"]["redeemScript"], hex_encode(&dup));
+
+    // 1-of-1 boundary works
+    let v = call(&d, "createmultisig", json!([1, [keys[2].clone()]]));
+    assert_eq!(v["error"], Value::Null, "1-of-1 must succeed: {v}");
+
+    // legacy error surfaces (byte-for-byte, same as addmultisigaddress)
+    let v = call(&d, "createmultisig", json!([]));
+    assert_eq!(v["error"]["code"], -8, "missing nrequired");
+    assert_eq!(v["error"]["message"], "expected nrequired parameter");
+    let v = call(&d, "createmultisig", json!([2]));
+    assert_eq!(v["error"]["code"], -8, "missing keys array");
+    assert_eq!(v["error"]["message"], "expected an array of keys");
+    let v = call(&d, "createmultisig", json!([0, keys]));
+    assert_eq!(v["error"]["code"], -1, "nrequired < 1");
+    assert_eq!(
+        v["error"]["message"],
+        "a multisignature address must require at least one key to redeem"
+    );
+    let v = call(&d, "createmultisig", json!([3, [keys[0], keys[1]]]));
+    assert_eq!(v["error"]["code"], -1, "not enough keys");
+    assert_eq!(
+        v["error"]["message"],
+        "not enough keys supplied (got 2 keys, but need at least 3 to redeem)"
+    );
+    // legacy check order: the count check fires BEFORE the 16-key refusal
+    let v = call(&d, "createmultisig", json!([17, [keys[0], keys[1]]]));
+    assert_eq!(
+        v["error"]["code"], -1,
+        "nrequired above the key count answers not-enough first"
+    );
+    let seventeen: Vec<String> = (10..27)
+        .map(|i| hex_encode(&pk(i as u64)))
+        .collect::<Vec<_>>();
+    let v = call(&d, "createmultisig", json!([1, seventeen]));
+    assert_eq!(
+        v["error"]["code"], -8,
+        "17 keys: legacy assert-aborts here, tri7 refuses"
+    );
+    assert_eq!(
+        v["error"]["message"],
+        "a multisignature address must require between 1 and 16 keys"
+    );
+    let v = call(&d, "createmultisig", json!([1, ["not-a-key-or-address"]]));
+    assert_eq!(v["error"]["code"], -1, "invalid key");
+    assert_eq!(
+        v["error"]["message"],
+        " Invalid public key: not-a-key-or-address"
+    );
+    let v = call(&d, "createmultisig", json!([1, [hex_encode(&[0x02, 0x55])]]));
+    assert_eq!(v["error"]["code"], -1, "hex but not a valid pubkey");
+    assert_eq!(v["error"]["message"], " Invalid public key: 0255");
+    // create-only: a Triangles ADDRESS is not a full pubkey — legacy gives
+    // any non-hex string the same refusal (base58 fails IsHex →
+    // rpcwallet.cpp:884)
+    let a1pk = pk(1);
+    let addr = crate::wallet::pubkey_to_address(&a1pk);
+    let v = call(&d, "createmultisig", json!([1, [addr]]));
+    assert_eq!(v["error"]["code"], -1, "an address is not a full pubkey here");
+    assert_eq!(v["error"]["message"], format!(" Invalid public key: {addr}"));
+    let v = call(&d, "createmultisig", json!([1, [42]]));
+    assert_eq!(v["error"]["code"], -1, "non-string key element");
+    assert_eq!(v["error"]["message"], "Invalid public key");
+
+    // and still, after every call above: the wallet file was never touched
+    let wf = crate::wallet::read_wallet(&path).unwrap();
+    assert!(
+        wf.scripts.is_empty() && wf.names.is_empty(),
+        "createmultisig must never write the wallet file"
+    );
+
+    let _ = std::fs::remove_dir_all(&dir);
+}
