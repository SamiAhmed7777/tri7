+        v2.tooltip.contains("amount = re-staked principal (reward unknown until rescan)"),
+        "{}",
+        v2.tooltip
+    );
+
+    stop.store(true, Ordering::Relaxed);
+    let _ = handle.join();
+    let _ = std::fs::remove_dir_all(&dir);
+}
