+        let mut cache = cache;
+        let filled = backfill_stake_nets(&store, &mut cache).unwrap();
+        assert_eq!(filled, 1, "only the store-provable stake is filled");
+        assert_eq!(cache.rows[1].stake_net, Some(39_590));
