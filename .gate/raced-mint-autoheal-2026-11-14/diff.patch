+        // a later re-log tick: same shape, still no burn
+        stg.staking_impaired.as_mut().unwrap().ticks = 40;
+        assert!(!autoheal_stale_live_view(&mut stg, &mut wl, &store, &mut stake_st));
+        assert_eq!(stake_st.autoheal_attempts, 0);
+    }
