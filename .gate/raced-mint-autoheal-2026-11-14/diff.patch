+        stake_st.autoheal_attempts = AUTOHEAL_MAX_ATTEMPTS;
+        assert!(!autoheal_due(&impaired(80, "e1"), &mut stake_st));
+        // …a fresh episode (the impairment fully cleared, then re-armed)
+        // re-arms the budget
+        assert!(autoheal_due(&impaired(1, "e2"), &mut stake_st));
+        assert_eq!(stake_st.autoheal_attempts, 0, "new episode resets the budget");
+    }
