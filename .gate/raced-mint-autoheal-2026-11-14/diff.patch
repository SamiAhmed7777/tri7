+    #[test]
+    fn autoheal_rebuild_removes_the_raced_phantom_and_keeps_the_honest_coin() {
+        let (mut stg, mut wl, raced_key, store) = autoheal_fixture("autoheal-rebuild");
+        // detect: the raced coin is the facts-MISMATCH class (absent:false)
+        let (cands, _nk, _ul, _ns) = wl.candidates();
+        assert_eq!(cands.len(), 2, "honest + raced, both candidates");
+        let (_rel, stale, _unres) = resolve_stake_evidence(&stg, cands);
+        assert_eq!(stale.len(), 1);
+        assert!(!stale[0].absent, "the raced-mint shape is a facts mismatch");
+        note_stale_evidence(&mut stg, &stale);
+        let first_utc = stg.staking_impaired.as_ref().unwrap().first_utc.clone();
+        let honest_before = wl.live.values().find(|o| o.height == 2 && o.value != 250_592_524).unwrap().clone();
+
+        // heal: one in-process pass removes the phantom, keeps the honest
+        // coin with identical facts, burns exactly one attempt
+        let mut stake_st = gate_stake_state();
+        assert!(autoheal_stale_live_view(&mut stg, &mut wl, &store, &mut stake_st));
+        assert_eq!(stake_st.autoheal_attempts, 1);
+        assert_eq!(stake_st.autoheal_episode.as_deref(), Some(first_utc.as_str()));
+        assert!(!wl.live.contains_key(&raced_key), "raced phantom removed");
+        let kept = wl
+            .live
+            .values()
+            .find(|o| o.value != 250_592_524)
+            .expect("honest coin kept");
+        assert_eq!(kept.block_time, honest_before.block_time);
+        assert_eq!(kept.tx_time, honest_before.tx_time);
+        assert_eq!(kept.tx_offset, honest_before.tx_offset);
+        assert_eq!(kept.value, honest_before.value);
+
+        // re-resolve on the rebuilt view: evidence matches → clear
+        let (c2, _nk, _ul, _ns) = wl.candidates();
+        let (_rel2, stale2, _unres2) = resolve_stake_evidence(&stg, c2);
+        assert!(stale2.is_empty(), "rebuilt view matches the chain");
+        stg.staking_impaired = None;
+        assert!(stg.staking_impaired.is_none());
+    }
