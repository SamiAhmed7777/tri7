+/// item 27 §16-RACED-MINT-AUTOHEAL: max in-process repairwallet passes per
+/// impairment episode. Three matches the documented live heal discipline
+/// (a pass can lag the detector, and a re-arming phantom can need a second
+/// pass); beyond that the condition is NOT self-healing (store behind the
+/// tip, a persistent fork) and an operator must look — the
+/// STAKE: STALE LIVE VIEW line keeps firing on its loud cadence either way.
+const AUTOHEAL_MAX_ATTEMPTS: u32 = 3;
+
+/// Should this tick fire the in-process repair attempt? Pure policy so the
+/// cadence/cap tests need no store: fires on the impairment's loud re-log
+/// cadence (first sighting, then every 40th tick ≈10 min at the default
+/// 15s stake cadence), at most `AUTOHEAL_MAX_ATTEMPTS` times per episode —
+/// a fresh episode (the impairment fully cleared in between, new
+/// `first_utc`) re-arms the budget. Records the episode as a side effect.
+fn autoheal_due(impaired: &StaleLiveView, stake_st: &mut StakeState) -> bool {
+    if stake_st.autoheal_episode.as_deref() != Some(impaired.first_utc.as_str()) {
+        stake_st.autoheal_episode = Some(impaired.first_utc.clone());
+        stake_st.autoheal_attempts = 0;
+    }
+    if stake_st.autoheal_attempts >= AUTOHEAL_MAX_ATTEMPTS {
+        return false;
+    }
+    impaired.ticks == 1 || impaired.ticks % 40 == 0
+}
+
+/// One in-process `repairwallet` attempt, fired by the stake tick when its
+/// stale-evidence determination is live (item 27 §16-RACED-MINT-AUTOHEAL).
+///
+/// WHY: a secondary staker that races a heavier branch (item 17 by design,
+/// races are SAFE) holds coins minted in its own abandoned block; the fork
+/// adoption rolls back the chain but NOT the wallet live view, the resolver
+/// excludes the raced coins, and staking starves until an operator runs
+/// `repairwallet`. Live DNS3 2026-11-14: three raced-mint impairments in
+/// ~3.5 h (11:2x, 13:58, 14:21 UTC), each healed by hand with the same
+/// deterministic, bounded, purely-local remedy — so the daemon now runs it
+/// itself: the exact `repairwallet` RPC rebuild (WalletLive::seed replay
+/// over the block store + repair_diff + swap), fired on the impairment's
+/// loud re-log cadence via `autoheal_due`, and skipped WITHOUT burning an
+/// attempt while the store cannot serve the replay window yet (transient —
+/// bodies still landing). The RPC verb stays operator-visible and behaves
+/// identically; the detection path (resolve_stake_evidence /
+/// note_stale_evidence) and the STAKE: STALE LIVE VIEW log text are
+/// untouched, so every fleet grep and --status surface keeps its meaning.
+///
+/// Returns true when the live view was REBUILT — the caller re-resolves
+/// the candidates and clears the impairment when the evidence now matches.
+fn autoheal_stale_live_view(
+    stg: &mut ChainState,
+    wl: &mut WalletLive,
+    store: &BlockStore,
+    stake_st: &mut StakeState,
+) -> bool {
+    let Some(impaired) = stg.staking_impaired.as_ref() else {
+        return false;
+    };
+    if !autoheal_due(impaired, stake_st) {
+        return false;
+    }
+    // the exact repairwallet replay window (RPC verb): base = min of the
+    // view's seed base and the chain-state base — a forkchoice rollback can
+    // walk the chain-state base back below the view's seed base, and
+    // replaying only from the view's base would then miss the restored
+    // branch; tip = the chain tip
+    let base = wl.base.min(stg.base);
+    let tip_hint = stg.tip_height;
+    let has_body = |h: u64| store.block_by_height(h).ok().flatten().is_some();
+    let (replay_tip, back) = newest_replayable_tip(&has_body, base, tip_hint);
+    if replay_tip <= base {
+        // store behind the view — transient (bodies still landing); the
+        // next re-log tick retries WITHOUT burning the attempt budget
+        log(&format!(
+            "stake: AUTOHEAL skipped — no stored bodies in h{base}..h{tip_hint} — store behind the tip, retry on the next re-log tick"
+        ));
+        return false;
+    }
+    let fresh = match WalletLive::seed(store, wl.wallet.clone(), base, replay_tip) {
+        Ok(f) => f,
+        Err(e) => {
+            log(&format!(
+                "stake: AUTOHEAL replay failed: {e} — retry on the next re-log tick"
+            ));
+            return false;
+        }
+    };
+    stake_st.autoheal_attempts += 1;
+    let diff = {
+        let owns = |o: &LiveOut| wl.owns(o);
+        repair_diff(&wl.live, &fresh.live, &owns)
+    };
+    log(&format!(
+        "stake: AUTOHEAL — ran the repairwallet remedy in-process: rebuilt live view h{base}..h{replay_tip} (walked back {back} from tip h{tip_hint}) — {} owned-output mismatch(es) totalling {} sats ({} phantom, {} lost)",
+        diff.count(),
+        diff.amount(),
+        diff.phantom.len(),
+        diff.lost.len(),
+    ));
+    wl.live = fresh.live;
+    // the map now covers [base, replay_tip]: keep the view's claimed base
+    // consistent with what was actually replayed (same as the RPC verb)
+    wl.base = base;
+    true
+}
