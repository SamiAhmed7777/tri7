+    // ---- item 27 §16-RACED-MINT-AUTOHEAL ----
+
+    /// A real block store h0..=h4 whose h2 body pays `pubkey` the honest
+    /// coin (block.time = the synthetic chain's entry time at h2), so a
+    /// WalletLive::seed replay over it reproduces that coin with exact
+    /// chain-slot facts — the autoheal rebuild fixture. Filler blocks carry
+    /// only an empty coinbase (value 0 + empty script → never enters a live
+    /// map), so the replay holds exactly ONE owned coin.
+    fn autoheal_store_with_honest_coin(
+        dir: &std::path::Path,
+        pubkey: &[u8],
+        value: i64,
+    ) -> std::sync::Arc<BlockStore> {
+        let script = tri7_core::spend::script_pubkey_p2pk(pubkey).unwrap();
+        let mut frames = Vec::new();
+        let mut hashes = Vec::new();
+        let mut prev = [0u8; 32];
+        for h in 0..=4u64 {
+            let mut b = Block {
+                version: 2,
+                prev_hash: prev,
+                merkle_root: [0u8; 32],
+                time: 1_700_000_000u32 + (h * 600) as u32,
+                bits: 0x2000_ffff,
+                nonce: 7,
+                vtx: vec![tri7_core::legacy::Tx {
+                    version: 1,
+                    time: 0,
+                    vin: vec![tri7_core::legacy::Vin {
+                        prev_hash: [0u8; 32],
+                        prev_n: u32::MAX,
+                        script_sig: vec![0x01],
+                        sequence: u32::MAX,
+                    }],
+                    vout: vec![tri7_core::legacy::Vout {
+                        value: 0,
+                        script_pubkey: vec![],
+                    }],
+                    locktime: 0,
+                }],
+                block_sig: vec![],
+            };
+            if h == 2 {
+                b.vtx = vec![tri7_core::legacy::Tx {
+                    version: 1,
+                    time: b.time,
+                    vin: vec![tri7_core::legacy::Vin {
+                        prev_hash: [0u8; 32],
+                        prev_n: u32::MAX,
+                        script_sig: vec![0x02],
+                        sequence: u32::MAX,
+                    }],
+                    vout: vec![tri7_core::legacy::Vout {
+                        value,
+                        script_pubkey: script.clone(),
+                    }],
+                    locktime: 0,
+                }];
+            }
+            b.merkle_root = b.merkle_root();
+            hashes.push(b.hash());
+            frames.extend_from_slice(&bin_frame(&b));
+            prev = b.hash();
+        }
+        let path = dir.join("blocks.bin");
+        std::fs::write(&path, &frames).unwrap();
+        let store = tri7_core::blockindex::BlockStore::new(Some(path), Some(dir.join("idx")));
+        store.spawn_build(Some(tri7_core::blockindex::BuildOracle {
+            base: 0,
+            hashes,
+            tip: 4,
+        }));
+        wait_store_ready(&store);
+        store
+    }
+
+    /// The raced-mint episode: chain h0..=h4 whose canonical map holds the
+    /// honest coin's meta plus a raced coin's meta, and a wallet live view
+    /// holding both — the raced coin with the ABANDONED block's
+    /// containing-block time (20s earlier, tx facts agreeing — the exact
+    /// DNS3 14:21:42Z shape). Returns (stg, wl, raced_key, store).
+    fn autoheal_fixture(
+        tag: &str,
+    ) -> (
+        ChainState,
+        WalletLive,
+        (Hash, u32),
+        std::sync::Arc<BlockStore>,
+    ) {
+        let (secret, pubkey) = tri7_core::spend::synthetic_key(tag);
+        let _ = secret;
+        let pubkey = pubkey.to_vec();
+        let dir = std::env::temp_dir().join(format!(
+            "tri7-{}-{}-{}",
+            tag,
+            std::process::id(),
+            now_secs()
+        ));
+        std::fs::create_dir_all(&dir).unwrap();
+        let store = autoheal_store_with_honest_coin(
+            &dir,
+            &pubkey,
+            50 * tri7_core::consensus::COIN,
+        );
+        // the honest coin as the REPLAY sees it (exact chain-slot facts)
+        let wallet_keys = wallet_live_with(&[pubkey.clone()], vec![]).wallet;
+        let fresh0 = WalletLive::seed(&store, wallet_keys, 0, 4).unwrap();
+        let honest_key = *fresh0
+            .live
+            .keys()
+            .find(|k| fresh0.owns(&fresh0.live[k]))
+            .expect("honest coin in the replay");
+        let honest = fresh0.live[&honest_key].clone();
+        assert_eq!(honest.height, 2);
+        let mut stg = synthetic_chain(0, 4);
+        stg.utxo.map.insert(
+            honest_key,
+            crate::kernel::UtxoMeta {
+                height: 2,
+                tx_offset: honest.tx_offset,
+                tx_time: honest.tx_time,
+                value: honest.value,
+            },
+        );
+        let raced_key: (Hash, u32) = ([0x5Bu8; 32], 1);
+        stg.utxo.map.insert(
+            raced_key,
+            crate::kernel::UtxoMeta {
+                height: 2,
+                tx_offset: honest.tx_offset,
+                tx_time: honest.tx_time, // tx facts agree…
+                value: 250_592_524,
+            },
+        );
+        let mut wl = wallet_live_with(&[pubkey], vec![(honest_key, honest.clone())]);
+        wl.base = 0;
+        wl.live.insert(
+            raced_key,
+            LiveOut {
+                height: 2,
+                block_time: honest.block_time - 20, // …block_time contradicts
+                tx_time: honest.tx_time,
+                tx_offset: honest.tx_offset,
+                value: 250_592_524,
+                script: honest.script.clone(),
+                created_epoch: honest.block_time - 20,
+                coinstake: false,
+                coinbase: false,
+            },
+        );
+        (stg, wl, raced_key, store)
+    }
+
