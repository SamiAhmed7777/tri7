+            chain_tx_time: 1,
+            absent: false,
+            coins: 1,
+            first_utc: "2026-11-14T14:21:42Z".into(),
+            ticks: 1,
+        });
+        let mut wl = wallet_live_with(&[vec![0x02u8; 33]], vec![]);
+        wl.base = 0;
+        // an empty store cannot serve the replay window — a TRANSIENT
+        // (bodies still landing): skip, and do NOT burn the attempt budget
+        let store = BlockStore::new(None, None);
+        let mut stake_st = gate_stake_state();
+        assert!(!autoheal_stale_live_view(&mut stg, &mut wl, &store, &mut stake_st));
+        assert_eq!(stake_st.autoheal_attempts, 0);
