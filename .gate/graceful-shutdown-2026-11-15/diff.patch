+    /// (item 29) graceful stop mid-backfill: the stop predicate fires part
+    /// way through pass 1 — the pass returns true, the floor is pinned at
+    /// the window top (item-24-r2 partial semantics: every absent coin
+    /// honestly unresolvable until the retry lane completes coverage), and
+    /// the heights folded before the stop STAY in the insert-only map. A
+    /// follow-up pass with no stop completes normally (false).
+    #[test]
+    fn backfill_graceful_stop_pins_the_floor_and_reports_the_stop() {
+        let mut prev: Hash = [0xABu8; 32];
+        let mut blocks: Vec<Block> = Vec::new();
+        for h in 0..=30u64 {
+            let b = mk_body_block(
+                prev,
+                0x60 + h as u8,
+                0x2000_ffff,
+                1_700_000_000u32 + (h * 600) as u32,
+            );
+            prev = b.hash();
+            blocks.push(b);
+        }
+        let mut stg = chain_state_from_window(0, &blocks);
+        // records [15..=30]: the backfill folds [0..15) in pass 1
+        stg.records = blocks[15..]
+            .iter()
+            .enumerate()
+            .map(|(i, b)| stg.record_of(b, 15 + i as u64))
+            .collect();
+        let rpc = Rpc::new("127.0.0.1", 1, "", ""); // dead port: pass 2 never answers
+        // stop AFTER 4 heights folded (one call per pass-1 height)
+        let calls = std::sync::atomic::AtomicUsize::new(0);
+        let stopped = boot_backfill_kernel_window(&mut stg, &rpc, &|| {
+            let n = calls.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+            n >= 4
+        });
+        assert!(stopped, "the stop predicate must end the pass with true");
+        assert_eq!(
+            stg.utxo_floor_rel,
+            stg.entries.len(),
+            "floor pinned at the window top — honest non-contiguous coverage"
+        );
+        // the checkpoint fires PER HEIGHT: called at rel 0..=4 (stop on the
+        // 5th) — four heights were queued for pass 2 (no live store in
+        // tests: pass-1 folds come from the store only)
+        assert_eq!(
+            calls.load(std::sync::atomic::Ordering::SeqCst),
+            5,
+            "one checkpoint call per pass-1 height before the stop"
+        );
+        // a fresh pass with no stop runs to completion (false) — pass 2
+        // finds no listener and the floor stays pinned honestly
+        let stopped2 = boot_backfill_kernel_window(&mut stg, &rpc, &|| false);
+        assert!(!stopped2, "an un-stopped pass reports false");
+        assert_eq!(
+            stg.utxo_floor_rel,
+            stg.entries.len(),
+            "pass 2 finds no listener — floor stays pinned honestly"
+        );
+    }
