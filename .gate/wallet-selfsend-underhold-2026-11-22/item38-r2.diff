+    /// vout1 pays the FUNDED key A 15.691664 TRI change).
+    fn item38_selfsend_store(
+        dir: &std::path::Path,
+        funded_pk: &[u8],
+        fresh_pk: &[u8],
+    ) -> std::sync::Arc<BlockStore> {
+        let change = tri7_core::spend::script_pubkey_p2pk(funded_pk).unwrap();
+        let fresh = tri7_core::spend::script_pubkey_p2pkh(fresh_pk);
+        const FRESH_V: i64 = 100 * tri7_core::consensus::COIN;
+        const CHANGE_V: i64 = 15_691_664; // 15.691664 TRI
+        let mut frames = Vec::new();
+        let mut hashes = Vec::new();
+        let mut prev = [0u8; 32];
+        for h in 0..=4u64 {
+            let mut b = Block {
+                version: 2,
+                prev_hash: prev,
+                merkle_root: [0u8; 32],
+                time: 1_700_000_000u32 + (h * 600) as u32,
+                bits: 0x2000_ffff,
+                nonce: 7,
+                vtx: vec![tri7_core::legacy::Tx {
+                    version: 1,
+                    time: 0,
+                    vin: vec![tri7_core::legacy::Vin {
+                        prev_hash: [0u8; 32],
+                        prev_n: u32::MAX,
+                        script_sig: vec![0x01],
+                        sequence: u32::MAX,
+                    }],
+                    vout: vec![tri7_core::legacy::Vout {
+                        value: 0,
+                        script_pubkey: vec![],
+                    }],
+                    locktime: 0,
+                }],
+                block_sig: vec![],
+            };
+            if h == 2 {
+                b.vtx = vec![
+                    // coinbase (empty)
+                    tri7_core::legacy::Tx {
+                        version: 1,
+                        time: b.time,
+                        vin: vec![tri7_core::legacy::Vin {
+                            prev_hash: [0u8; 32],
+                            prev_n: u32::MAX,
+                            script_sig: vec![0x02],
+                            sequence: u32::MAX,
+                        }],
+                        vout: vec![tri7_core::legacy::Vout {
+                            value: 0,
+                            script_pubkey: vec![],
+                        }],
+                        locktime: 0,
+                    },
+                    // coinstake-shaped tx1: real vin, value-0 empty first vout
+                    tri7_core::legacy::Tx {
+                        version: 1,
+                        time: b.time,
+                        vin: vec![tri7_core::legacy::Vin {
+                            prev_hash: [1u8; 32],
+                            prev_n: 0,
+                            script_sig: vec![],
+                            sequence: u32::MAX,
+                        }],
+                        vout: vec![tri7_core::legacy::Vout {
+                            value: 0,
+                            script_pubkey: vec![],
+                        }],
+                        locktime: 0,
+                    },
+                    // tx2: THE SELF-SEND
+                    tri7_core::legacy::Tx {
+                        version: 1,
+                        time: b.time,
+                        vin: vec![tri7_core::legacy::Vin {
+                            prev_hash: [9u8; 32],
+                            prev_n: 0,
+                            script_sig: vec![],
+                            sequence: u32::MAX,
+                        }],
+                        vout: vec![
+                            tri7_core::legacy::Vout {
+                                value: FRESH_V,
+                                script_pubkey: fresh.clone(),
+                            },
+                            tri7_core::legacy::Vout {
+                                value: CHANGE_V,
+                                script_pubkey: change.clone(),
+                            },
