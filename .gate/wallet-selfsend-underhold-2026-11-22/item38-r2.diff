+/// Merge keys found in the wallet FILE into the in-memory keystore
+/// (item 38 WALLET-SELFSEND-UNDERHOLD). Merge-ONLY by pubkey: existing keys
+/// are never removed or touched, because the in-memory entries may carry
+/// runtime state a file re-read must not clobber (walletpassphrase-filled
+/// secrets on an encrypted wallet). Returns the keys that were ADDED.
+fn merge_wallet_keys(
+    wallet: &mut tri7_core::wallet::WalletKeys,
+    fresh: tri7_core::wallet::WalletKeys,
+) -> Vec<tri7_core::wallet::WalletKey> {
+    let mut have: std::collections::HashSet<Vec<u8>> =
+        wallet.keys.iter().map(|k| k.pubkey.clone()).collect();
+    let mut added = Vec::new();
+    for k in fresh.keys {
+        // insert() is the single gate: skips keys already in the wallet AND
+        // duplicates within the file read itself. Dedupe is pubkey-level by
+        // design — two pubkeys deriving the same address are NOT a duplicate
+        // (each is its own spendable identity), only a same-pubkey row is.
+        if have.insert(k.pubkey.clone()) {
+            added.push(k);
+        }
+    }
+    wallet.keys.extend(added.iter().cloned());
+    added
+}
