+    /// Merge-only discipline: existing in-memory entries (with runtime
+    /// unlock state) are never touched; the same key never double-adds.
+    #[test]
+    fn keystore_refresh_merge_is_additive_and_idempotent() {
+        let (_sa, pa) = tri7_core::spend::synthetic_key("item38-merge-a");
+        let (_sb, pb) = tri7_core::spend::synthetic_key("item38-merge-b");
+        let (_sc, pc) = tri7_core::spend::synthetic_key("item38-merge-c");
+        let (pa, pb, pc) = (pa.to_vec(), pb.to_vec(), pc.to_vec());
+        let mut wallet = wallet_live_with(&[pa.clone()], vec![]).wallet;
+        wallet.keys[0].secret = [0x11; 32]; // runtime unlock state
+        let mut fresh = wallet_live_with(&[pa.clone(), pb.clone()], vec![]).wallet;
+        fresh.keys.iter_mut().for_each(|k| k.secret = [0x22; 32]);
+        let added = merge_wallet_keys(&mut wallet, fresh);
+        assert_eq!(added.len(), 1, "only the unknown pubkey lands");
+        assert_eq!(added[0].pubkey, pb);
+        assert_eq!(wallet.keys[0].secret, [0x11; 32], "existing key untouched");
+        // a re-read carrying one more new key adds exactly that one
+        let fresh2 = wallet_live_with(&[pa.clone(), pb.clone(), pc.clone()], vec![]).wallet;
+        let added2 = merge_wallet_keys(&mut wallet, fresh2);
+        assert_eq!(added2.len(), 1);
+        assert_eq!(added2[0].pubkey, pc);
+        // and a fully-known key set is a no-op
+        let fresh3 = wallet_live_with(&[pa, pb, pc], vec![]).wallet;
+        assert!(merge_wallet_keys(&mut wallet, fresh3).is_empty());
+        assert_eq!(wallet.keys.len(), 3);
+    }
