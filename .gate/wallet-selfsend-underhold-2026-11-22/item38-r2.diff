+    /// Unreadable wallet files (no path, missing file, ENCRYPTED container)
+    /// are a silent skip — the caller stays on its current keys.
+    #[test]
+    fn keystore_refresh_skips_unreadable_wallet_files() {
+        assert!(refresh_keys_from_file(None).is_none());
+        assert!(refresh_keys_from_file(Some(std::path::Path::new(
+            "/nonexistent/item38-no-such-wallet.dat"
+        )))
+        .is_none());
+        let dir = std::env::temp_dir().join(format!(
+            "tri7-item38-enc-{}-{}",
+            std::process::id(),
+            now_secs()
+        ));
+        std::fs::create_dir_all(&dir).unwrap();
+        let file = dir.join("enc.dat");
+        let conn = rusqlite::Connection::open(&file).unwrap();
+        conn.execute_batch(&format!(
+            "PRAGMA application_id = {}; CREATE TABLE main (key BLOB PRIMARY KEY NOT NULL, value BLOB NOT NULL);",
+            tri7_core::wallet::WALLET_APP_ID
+        ))
+        .unwrap();
+        // one mkey row is enough to mark the container encrypted
+        conn.execute(
+            "INSERT INTO main (key, value) VALUES (?1, ?2)",
+            [vec![4u8, b'm', b'k', b'e', b'y', 0u8], vec![0u8]],
+        )
+        .unwrap();
+        drop(conn);
+        assert!(refresh_keys_from_file(Some(&file)).is_none());
+    }
