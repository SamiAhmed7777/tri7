+        // below the window base → not comparable
+        assert_eq!(claim_divergence_verdict(&stg, Some((99, [0xEE; 32]))), None);
+        // no claim yet → None
+        assert_eq!(claim_divergence_verdict(&stg, None), None);
+    }
