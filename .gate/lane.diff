+                    Ok((mut s, _)) => {
+                        let _ = std::io::Write::write_all(&mut s, &[0x05, 0x00]);
+                        drop(s);
+                    }
+                    Err(e) if e.kind() == std::io::ErrorKind::WouldBlock => {
+                        std::thread::sleep(Duration::from_millis(25));
+                    }
+                    Err(_) => break,
+                }
+            }
