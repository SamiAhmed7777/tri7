+        sup3.spawn_override = Some(Arc::new(
+            |_req: TorSpawnRequest| -> Result<Child, String> {
+                panic!("attach mode must never spawn tor");
+            },
+        ));
+        assert_eq!(sup3.ensure(&dir, false), TorStatus::Unavailable);
+        let _ = std::fs::remove_dir_all(&dir);
+    }
