+            version: 1,
+            time: 1_700_000_000,
+            vin: vec![tri7_core::legacy::Vin {
+                prev_hash: [0u8; 32],
+                prev_n: u32::MAX,
+                script_sig: vec![v],
+                sequence: u32::MAX,
+            }],
+            vout: vec![tri7_core::legacy::Vout {
+                value: val,
+                script_pubkey: vec![0x51],
+            }],
+            locktime: 0,
+        }
+    }
+
