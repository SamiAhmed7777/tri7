+                txid,
+                n,
+                value: 2_000_000,
+                script_pubkey: script,
+                height: 100,
+                tx_time: 1_700_000_000,
+                is_coinbase: false,
+                is_coinstake: false,
+                secret: secret_of(b),
+                pubkey: pk,
+            }
+        };
+        let p2pk_script = tri7_core::spend::script_pubkey_p2pk(&pk_a).unwrap();
+        let p2pkh_script = p2pkh_script(&pk_b);
