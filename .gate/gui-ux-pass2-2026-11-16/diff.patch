+/// The copy must stay free of the words this pass exists to remove. (Brand
+/// nouns — Triangles, TRI, wallet, address — are deliberately NOT on the list.)
+#[test]
+fn pass_two_copy_avoids_internal_jargon() {
+    use crate::gui::plain_words as pw;
+    const JARGON: [&str; 14] = [
+        "mnemonic",
+        "BIP39",
+        "HD wallet",
+        "pre-HD",
+        "UTXO",
+        "input",
+        "inputs",
+        "checksum",
+        "derivation",
+        "m/44",
+        "ksats",
+        "sats",
+        "txid",
+        "hex",
+    ];
+    let mut all: Vec<&str> = vec![
+        pw::WELCOME_TITLE,
+        pw::WELCOME_BODY,
+        pw::CREATE_WALLET,
+        pw::RESTORE_WALLET,
+        pw::OPEN_WALLET_FILE,
+        pw::NO_COINS_TITLE,
+        pw::NO_COINS_BODY,
+        pw::NO_COINS_SEND,
+        pw::SEND_TO,
+        pw::HOW_MUCH,
+        pw::NETWORK_FEE,
+        pw::FEE_HINT,
+        pw::AMOUNT_HINT,
+        pw::REVIEW_SEND,
+        pw::SEND_NOW,
+        pw::LOCAL_SIGNING_LINE,
+        pw::NEW_ADDRESS,
+        pw::COPY_ADDRESS,
+        pw::YOUR_ADDRESS,
+        pw::SEED_BACKUP_LINE,
+        pw::FILE_BACKUP_LINE,
+    ];
+    let doors = pw::first_run_entry_points();
+    for d in doors.iter() {
+        all.push(d.label);
+        all.push(d.hint);
+    }
+    for s in all {
+        let lower = s.to_lowercase();
+        for bad in JARGON {
+            assert!(
+                !lower.contains(&bad.to_lowercase()),
+                "{bad:?} leaked into pass-2 copy: {s:?}"
+            );
+        }
+    }
+}
